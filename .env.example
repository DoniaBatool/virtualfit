# ─── Database ─────────────────────────────────────────────────────────────────
# Local Docker (default)
DATABASE_URL=postgresql://vtuser:vtpass@localhost:5432/virtual_tryon

# NeonDB (production) — get from https://neon.tech
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/virtual_tryon?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRY_HOURS=24

# ─── MinIO (Image Storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tryon-images
MINIO_USE_SSL=false

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=garments

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Service URLs ─────────────────────────────────────────────────────────────
GATEWAY_URL=http://localhost:3004
ML_PIPELINE_URL=http://localhost:8001
IMAGE_PROCESSOR_URL=http://localhost:8090
DASHBOARD_URL=http://localhost:3002

# ─── ML Config ────────────────────────────────────────────────────────────────
# "mps" for M2 Mac, "cuda" for NVIDIA, "cpu" as fallback
TORCH_DEVICE=mps
MODEL_WEIGHTS_DIR=./services/ml-pipeline/models/weights
